<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="UniCampus.Web.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UniCampus · Sistema de Gestión Académica</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <header class="barra">
            <div class="contenedor barra-interior">
                <a class="marca" href="<%: ResolveUrl("~/Default.aspx") %>">
                    <span class="marca-sello" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
                    <span>UniCampus</span>
                </a>

                <nav class="navegacion" aria-label="Principal">
                    <a class="<%: ClaseMenu("Default.aspx") %>" href="<%: ResolveUrl("~/Default.aspx") %>">Inicio</a>
                    <a class="<%: ClaseMenu("Actividades.aspx") %>" href="<%: ResolveUrl("~/Actividades.aspx") %>">Actividades</a>
                    <a class="<%: ClaseMenu("MisInscripciones.aspx") %>" href="<%: ResolveUrl("~/MisInscripciones.aspx") %>">Mis inscripciones</a>
                    <asp:PlaceHolder ID="phMenuReportes" runat="server">
                        <a class="<%: ClaseMenu("Reportes.aspx") %>" href="<%: ResolveUrl("~/Reportes.aspx") %>">Reportes</a>
                    </asp:PlaceHolder>
                    <a class="<%: ClaseMenu("Perfil.aspx") %>" href="<%: ResolveUrl("~/Perfil.aspx") %>">Perfil</a>
                </nav>

                <div class="sesion">
                    <div class="sesion-usuario">
                        <div>
                            <strong><asp:Literal ID="litNombreUsuario" runat="server" /></strong>
                            <small><asp:Literal ID="litRolUsuario" runat="server" /></small>
                        </div>
                        <span class="iniciales" aria-hidden="true"><asp:Literal ID="litIniciales" runat="server" /></span>
                    </div>
                    <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="btn btn-sm btn-salir" OnClick="btnCerrarSesion_Click"
                        CausesValidation="false" ToolTip="Cerrar sesión">
                        <i class="bi bi-box-arrow-right"></i><span>Salir</span>
                    </asp:LinkButton>
                </div>
            </div>
        </header>

        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
    </form>
    <script>
        // Los mensajes de éxito se ocultan solos; los de error quedan hasta que se cierren.
        setTimeout(function () {
            var toasts = document.querySelectorAll('.toast-exito');
            for (var i = 0; i < toasts.length; i++) { toasts[i].classList.add('toast-salida'); }
        }, 6000);
    </script>
</body>
</html>
