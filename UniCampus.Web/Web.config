<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de UniCampus.Web
  La cadena "UniCampusDb" usa SQL Server LocalDB (incluido con Visual Studio).
  Si usa SQL Server Express cambie Data Source por .\SQLEXPRESS.
  No incluya usuarios ni contraseñas reales en el repositorio.
-->
<configuration>
  <connectionStrings>
    <add name="UniCampusDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=UniCampusDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="4096" />
    <globalization culture="es-CO" uiCulture="es" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <sessionState mode="InProc" timeout="30" cookieless="UseCookies" />
    <httpCookies httpOnlyCookies="true" sameSite="Lax" />
    <authentication mode="None" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
